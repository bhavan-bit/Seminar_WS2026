# ==============================================================================
# Git Ignore — OCPM Predictive Process Monitoring Benchmark
# ==============================================================================

# Local virtual environments
.venv/
venv/
env/
ENV/

# All datasets, preprocessed artifacts, and experimental outputs
# (preserve directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/preprocessed/*
!data/preprocessed/.gitkeep
data/results/*
!data/results/.gitkeep

# Common data / model / archive formats anywhere in the repo
*.jsonocel
*.xmlocel
*.ocel
*.sqlite
*.sqlite3
*.db
*.parquet
*.feather
*.csv
*.tsv
*.xlsx
*.pt
*.pth
*.ckpt
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.zip
*.tar.gz

# Secrets, credentials, and local environment overrides
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*secret*
*credential*
secrets.yaml
secrets.yml
secrets.json

# Python build, cache, and test artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks & checkpoints
.ipynb_checkpoints/

# Logs
*.log
logs/

# OS & editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

